# ========== PaddleOCR 專用 Callback 路由 ==========
@app.get("/paddleocr_callback")
@app.post("/paddleocr_callback")
async def paddleocr_callback_proxy(request: Request):
    """PaddleOCR SSO Callback（轉發到 8095）"""
    logger.info(f"[PROXY] PaddleOCR callback")
    return await proxy_request(request, BACKENDS["paddleocr"], "/paddleocr/query/callback")


@app.get("/paddleocr_logout_callback")
async def paddleocr_logout_callback_proxy(request: Request):
    """PaddleOCR Logout Callback（轉發到 8095）"""
    logger.info(f"[PROXY] PaddleOCR logout callback")
    return await proxy_request(request, BACKENDS["paddleocr"], "/paddleocr/query/logout_callback")

@app.api_route("/{full_path:path}", methods=["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"])
async def catch_all(request: Request, full_path: str):
    """
    統一路由處理
    """
    path = f"/{full_path}"
    
    # SSO 路由已在 UnifiedSSO 中註冊，不會到這裡
    
    # 判斷後端服務
    backend_url, target_path = get_backend_for_path(path)
    
    if backend_url == BACKENDS["bpm"]:
        return await proxy_request_bpm(request, target_path)
    elif backend_url == BACKENDS["upload"]:
        # ESG 上傳系統：白名單卡控
        from urllib.parse import unquote as _uq
        emp_id = _uq(request.cookies.get("preferred_username", "")).strip()
        if not emp_id:
            from urllib.parse import quote as _q
            return RedirectResponse(f"/login?next={_q(path, safe='')}", status_code=302)
        if emp_id not in ESG_UPLOAD_WHITELIST:
            name = _uq(request.cookies.get("family_name", emp_id))
            return HTMLResponse(content=f"""<!DOCTYPE html>
<html><head><meta charset="UTF-8"><title>無存取權限</title>
<style>body{{font-family:Arial,sans-serif;text-align:center;padding:80px;background:#f5f5f5}}
.box{{background:white;display:inline-block;padding:50px 80px;border-radius:12px;box-shadow:0 2px 12px rgba(0,0,0,.12)}}
h1{{color:#e74c3c}}p{{color:#666}}a{{color:#3498db}}</style></head>
<body><div class="box"><h1>🔒 無存取權限</h1>
<p>您好，<b>{name}</b>（{emp_id}）</p>
<p>ESG 附件三上傳系統僅限授權人員存取。</p>
<p>如需申請權限，請聯繫 IT：Frank.Fu@ennostar.com</p>
<p><a href="/logout">登出</a></p></div></body></html>""", status_code=403)
        return await proxy_request(request, backend_url, target_path)
    elif backend_url:
        return await proxy_request(request, backend_url, target_path)
    else:
        logger.warning(f"[PROXY] No backend found for path: {path}")
        return Response("Not Found", status_code=404)


@app.on_event("shutdown")
async def shutdown_event():
    """關閉時清理資源"""
    await http_client.aclose()


