# ESG 上傳系統白名單（/esg/upload/ 卡控）
ESG_UPLOAD_WHITELIST = {
    "2508105",  # 傅士軒 Frank Fu
    "1009024",  # 周昱宏 Jovi Chou
    "2305018",  # 陳奕豪 Harry Chen
    "0403004",  # 顏志忠 Titan Yen
