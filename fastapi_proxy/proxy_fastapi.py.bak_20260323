# 初始化統一 SSO
sso = UnifiedSSO(app, SSO_CONFIG)

# HTTP 客戶端（用於代理請求）
http_client = httpx.AsyncClient(
    timeout=httpx.Timeout(connect=15.0, read=300.0, write=60.0, pool=15.0),
    follow_redirects=False
)


def get_backend_for_path(path: str) -> tuple[str, str]:
    """
    根據路徑判斷後端服務
    返回：(backend_url, stripped_path)
    """
    if path.startswith("/esg/upload/"):
        # /esg/upload/xxx → 8001 的 /esg/upload/xxx（保留完整路徑）
        return BACKENDS["upload"], path
    
    elif path.startswith("/esg/download/"):
        # /esg/download/xxx → 8002 的 /esg/download/xxx
        return BACKENDS["download"], path
    
    elif path.startswith("/api/security-c/") or path.startswith("/api/attachment3/"):
        # /api/security-c/* → 8002 (download)
        return BACKENDS["download"], path
    
    elif path.startswith("/paddleocr/"):
        # /paddleocr/xxx → 8095 的 /paddleocr/xxx
        return BACKENDS["paddleocr"], path

    elif path.startswith("/mailbox/BPM302"):
        # /mailbox/BPM302/* → 10.100.40.5:8060/* (strip prefix)
        stripped = path[len("/mailbox/BPM302"):]
        if not stripped:
            stripped = "/"
        return BACKENDS["bpm"], stripped

    else:
        return None, None



async def proxy_request_bpm(request: Request, path: str):
    """BPM Dashboard 專用 proxy：將 unified_sso cookie 轉換為 bpm_ 前綴"""
    # 登出攔截：轉交 unified_sso 的 /logout 處理，確保清除 ssw01 domain 的 cookie
    if path in ("/api/logout", "/api/logout_cookie"):
        from fastapi.responses import RedirectResponse as _RR
        return _RR("/logout", status_code=302)

    # SSO 認證檢查：未登入時轉向 /login，登入後回到 /mailbox/BPM302/
    if not request.cookies.get("preferred_username"):
        # API 請求直接回 401（避免 JS fetch 被重導向）
        if path.startswith("/api/"):
            from fastapi.responses import JSONResponse as _JR
            return _JR({"detail": "Unauthorized"}, status_code=401)
        from urllib.parse import quote as _quote
        next_path = _quote("/mailbox/BPM302/", safe="")
        from fastapi.responses import RedirectResponse as _RR
        return _RR(f"/login?next={next_path}", status_code=302)

    target_url = f"{BACKENDS['bpm']}{path}"
    if request.url.query:
        target_url += f"?{request.url.query}"

    logger.info(f"[BPM] {request.method} {request.url.path} → {target_url}")

    headers = {
        key: value for key, value in request.headers.items()
        if key.lower() not in ["host", "content-length", "cookie"]
    }

    # 複製所有 cookie，並將 preferred_username 等加上 bpm_ 前綴（供 backend SSO 辨識）
    cookies = dict(request.cookies)
    BPM_COOKIE_FIELDS = ["preferred_username", "family_name", "email", "dep",
                         "client_secret", "refresh_token", "logout_url"]
    for field in BPM_COOKIE_FIELDS:
        if field in cookies and f"bpm_{field}" not in cookies:
            cookies[f"bpm_{field}"] = cookies[field]

    cookie_header = "; ".join(f"{k}={v}" for k, v in cookies.items())
    if cookie_header:
        headers["cookie"] = cookie_header

    body = await request.body()
    try:
        response = await http_client.request(
            method=request.method,
            url=target_url,
            headers=headers,
            content=body,
        )
        excluded_headers = ["content-encoding", "content-length", "transfer-encoding", "connection"]
        response_headers = {
            key: value for key, value in response.headers.items()
            if key.lower() not in excluded_headers
        }
        if response.status_code in [301, 302, 303, 307, 308]:
            location = response.headers.get("location", "")
            # 若 backend 跳轉到自己的 /callback → 改回 proxy 的路徑
            if location.startswith("http://10.100.40.5:8060"):
                location = location.replace("http://10.100.40.5:8060", "")
                if not location:
                    location = "/mailbox/BPM302/"
                else:
                    location = "/mailbox/BPM302" + location
                response_headers["location"] = location
        return Response(
            content=response.content,
            status_code=response.status_code,
            headers=response_headers,
        )
    except Exception as e:
        logger.error(f"[BPM PROXY ERROR] {e}")
        return Response(content=f"Proxy Error: {str(e)}", status_code=502)

async def proxy_request(request: Request, backend_url: str, path: str):
    """
    核心代理函數
    """
    # 構建目標 URL
    target_url = f"{backend_url}{path}"
    if request.url.query:
        target_url += f"?{request.url.query}"
    
    logger.info(f"[PROXY] {request.method} {request.url.path} → {target_url}")
    
    # 複製請求頭（排除 Host）
    headers = {
        key: value for key, value in request.headers.items()
        if key.lower() not in ["host", "content-length"]
    }
    
    # 複製請求體
    body = await request.body()
    
    try:
        # 發送代理請求
        response = await http_client.request(
            method=request.method,
            url=target_url,
            headers=headers,
            content=body,
            cookies=request.cookies,
        )
        
        # 複製回應頭（排除特殊頭）
        excluded_headers = ["content-encoding", "content-length", "transfer-encoding", "connection"]
        response_headers = {
            key: value for key, value in response.headers.items()
            if key.lower() not in excluded_headers
        }
        
        # 處理重定向
        if response.status_code in [301, 302, 303, 307, 308]:
            location = response.headers.get("location")
            if location:
                logger.info(f"[PROXY] Redirect: {location}")
                # 可以在這裡處理 location 重寫（如果需要）
                response_headers["location"] = location
        
        # 返回回應
        return Response(
            content=response.content,
            status_code=response.status_code,
            headers=response_headers,
        )
    
    except Exception as e:
        logger.error(f"[PROXY ERROR] {e}")
        return Response(
            content=f"Proxy Error: {str(e)}",
            status_code=502
        )


