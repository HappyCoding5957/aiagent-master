"""
FastAPI 統一 Proxy 服務
端口：4202（與舊版保持一致，外部 Nginx 不需要改）

路由規則：
- /esg/upload/* → 8001 (FastAPI Upload)
- /esg/download/* → 8002 (FastAPI Download)  
- /paddleocr/* → 8095 (FastAPI PaddleOCR)
- /login, /callback, /logout, /logout_callback → 統一 SSO
"""
from fastapi import FastAPI, Request, Response
from fastapi.responses import RedirectResponse, StreamingResponse, HTMLResponse
import httpx
import logging
from unified_sso import UnifiedSSO
from urllib.parse import unquote

