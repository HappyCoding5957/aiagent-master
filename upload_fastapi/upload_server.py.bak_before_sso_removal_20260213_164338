@app.get("/esg/upload/api/status")
async def status_check(request: Request):
    """狀態檢查：返回當前用戶登入狀態"""
    user = sso.get_current_user(request)
    if user:
        return JSONResponse({
            "logged_in": True,
            "user": user
        })
    else:
        return JSONResponse({
            "logged_in": False
        }, status_code=401)


@app.get("/esg/upload/api/logout")
async def api_logout(request: Request):
