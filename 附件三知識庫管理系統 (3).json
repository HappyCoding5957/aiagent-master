    {
      "parameters": {
        "command": "# 讀取進度檔案並輸出 JSON\nPROGRESS_FILE=\"/tmp/attachment3_upload_progress.json\"\n\nif [ -f \"$PROGRESS_FILE\" ]; then\n  # 檔案存在，直接輸出內容\n  cat \"$PROGRESS_FILE\"\nelse\n  # 檔案不存在，輸出預設 JSON\n  echo '{\"stage\":\"idle\",\"percent\":0,\"message\":\"尚未開始\"}'\nfi"
      },
      "id": "8fb95c68-5b13-49c6-a8ea-09dc30dc5789",
      "name": "讀取進度檔案",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        704,
        1008
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json; charset=utf-8"
              },
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              }
            ]
          }
        }
      },
      "id": "31424724-2f50-49e0-911c-d00cf5f1956c",
      "name": "回傳進度JSON",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        912,
        1008
      ]
    },
    {
      "parameters": {
        "jsCode": "// 直接返回固定的測試數據\nreturn [{\n  json: {\n    exists: false,\n    pdf_id: null,\n    name: null,\n    chunk_count: null,\n    last_update: null,\n    unit: null,\n    debug: \"generated_from_code_node\"\n  }\n}];"
      },
      "id": "36081e53-87c9-4bbb-9bd1-97d117b8943a",
      "name": "生成狀態數據",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        512,
        512
      ]
    },
    {
      "parameters": {
        "jsCode": "// 保底進度輸出\nconsole.log('[progress-fallback-1] input count =', $input.all().length);\n\nconst items = $input.all();\n\nif (!items || items.length === 0 || !items[0].json) {\n  console.log('[progress-fallback-2] empty -> default idle');\n  return [{\n    json: {\n      stage: 'idle',\n      percent: 0,\n      message: '尚未開始',\n      _fallback: 'empty_input'\n    }\n  }];\n}\n\nconst d = items[0].json || {};\nconsole.log('[progress-fallback-3] keys =', Object.keys(d));\n\nreturn [{\n  json: {\n    stage: d.stage || 'idle',\n    percent: d.percent ?? 0,\n    message: d.message || '-',\n    _fallback: 'none'\n  }\n}];"
      },
      "id": "fallback_progress_output",
      "name": "保底進度輸出",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        928,
        1008
      ]
    },
    {
      "parameters": {
        "jsCode": "// 保底上傳輸出 - 統一使用 text 欄位\nconsole.log('[upload-fallback-1] input count =', $input.all().length);\n\nconst items = $input.all();\n\nlet jsonData;\nif (!items || items.length === 0 || !items[0].json) {\n  console.log('[upload-fallback-2] empty -> error response');\n  jsonData = {\n    success: false,\n    error: '上傳失敗：無法取得上游結果',\n    _fallback: 'empty_input'\n  };\n} else {\n  const d = items[0].json || {};\n  console.log('[upload-fallback-3] keys =', Object.keys(d));\n  jsonData = d;\n}\n\n// 生成帶標記的文字輸出（前端需要）\nconst textOutput = `=== JSON_OUTPUT_START ===\n${JSON.stringify(jsonData, null, 2)}\n=== JSON_OUTPUT_END ===`;\n\nreturn [{\n  json: jsonData,\n  text: textOutput\n}];"
      },
      "id": "fallback_upload_output",
      "name": "保底上傳輸出",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1072,
        704
      ]
    },
    {
      "parameters": {
        "jsCode": "// 保底刪除輸出\nconsole.log('[delete-fallback-1] input count =', $input.all().length);\n\nconst items = $input.all();\n\nif (!items || items.length === 0 || !items[0].json) {\n  console.log('[delete-fallback-2] empty -> assume success');\n  return [{\n    json: {\n      success: true,\n      message: '刪除完成',\n      deleted_chunks: 0,\n      deleted_file: true,\n      _fallback: 'empty_input'\n    }\n  }];\n}\n\nconst d = items[0].json || {};\nconsole.log('[delete-fallback-3] keys =', Object.keys(d));\n\nreturn [{\n  json: {\n    success: true,\n    message: d.message || '刪除完成',\n    deleted_chunks: d.deleted_chunks ?? 0,\n    deleted_file: d.deleted_file ?? true,\n    _fallback: 'none'\n  }\n}];"
      },
      "id": "fallback_delete_output",
      "name": "保底刪除輸出",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
