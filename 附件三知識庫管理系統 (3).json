      "parameters": {
        "jsCode": "// 提取上傳檔案的 binary data\nconst items = $input.all();\n\nif (!items || items.length === 0) {\n  return [{\n    json: {\n      success: false,\n      error: '沒有接收到檔案'\n    }\n  }];\n}\n\n// 取得檔案的 binary data\nconst item = items[0];\n\nif (!item.binary || !item.binary.file) {\n  return [{\n    json: {\n      success: false,\n      error: '無法找到上傳的檔案'\n    }\n  }];\n}\n\nconst fileData = item.binary.file;\n\n// 返回檔案資訊和 base64 數據\nreturn [{\n  json: {\n    success: true,\n    fileName: fileData.fileName || 'unknown',\n    mimeType: fileData.mimeType || 'application/octet-stream',\n    fileSize: fileData.fileSize || 0,\n    base64Data: fileData.data  // base64 編碼的檔案內容\n  }\n}];"
      },
