from fastapi import FastAPI, Request, Depends, HTTPException
from fastapi.responses import HTMLResponse, FileResponse, JSONResponse, RedirectResponse
from fastapi.staticfiles import StaticFiles
from urllib.parse import unquote
import os
import logging
from pathlib import Path

# 統一 SSO 中間件
from unified_sso import UnifiedSSO

# 配置日誌
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

# 創建 FastAPI app
app = FastAPI(title="ESG Download System", version="2.0")

# 配置路徑
BASE_DIR = Path(__file__).parent
STATIC_DIR = BASE_DIR / "static"
TEMPLATES_DIR = BASE_DIR / "templates"
DOCS_DIR = BASE_DIR / "docs"

# 掛載靜態文件
app.mount("/static", StaticFiles(directory=str(STATIC_DIR)), name="static")
app.mount("/docs/assets", StaticFiles(directory=str(DOCS_DIR / "assets")), name="docs_assets")

# SSO 配置
SSO_CONFIG = {
    "realm": "Infra",
    "client_id": "MeetBook",
    "client_secret": "WKRuv36gORlne3DP3aVhx1sJwqoJP8tq",
    "frontend_url": "https://ssw01.ennostar.com",
    "sso_api": "http://espython-sso-api.epistar.com.tw:8080"
}

# 初始化統一 SSO（註冊 /login, /callback, /logout, /logout_callback 路由）
sso = UnifiedSSO(app, SSO_CONFIG)


def get_current_user(request: Request):
    """獲取當前登入用戶（依賴注入）"""
    user = sso.get_current_user(request)
    if not user:
        # 未登入，重定向到登入頁
        raise HTTPException(
            status_code=307,
            headers={"Location": f"/login?next={request.url.path}"}
        )
    return user


@app.get("/favicon.ico")
async def favicon():
    """提供 favicon"""
    favicon_path = STATIC_DIR / "favicon.ico"
    if favicon_path.exists():
        return FileResponse(favicon_path)
    return Response("Not Found", status_code=404)


# 根路徑不需要處理，所有請求都通過 /esg/download/ 進入


@app.get("/esg/download/", response_class=HTMLResponse)
async def download_page(request: Request, user: dict = Depends(get_current_user)):
    """ESG 下載頁面（受 SSO 保護）"""
    logger.info(f"[SSO] 用戶 {user['family_name']} ({user['preferred_username']}) 存取下載頁面")
    
    # 讀取 HTML 模板
    html_file = TEMPLATES_DIR / "test_upload.html"
    if html_file.exists():
        with open(html_file, "r", encoding="utf-8") as f:
            html_content = f.read()
        return HTMLResponse(content=html_content)
    else:
        return HTMLResponse("<h1>ESG Download System</h1><p>模板文件不存在</p>")


@app.get("/api/health")
async def health_check():
    """健康檢查"""
    return JSONResponse({
        "status": "healthy",
        "service": "ESG Download System (FastAPI)",
        "version": "2.0",
        "port": 8002
    })


@app.get("/api/status")
async def status_check(request: Request):
    """狀態檢查：返回當前用戶登入狀態"""
    user = sso.get_current_user(request)
    if user:
        return JSONResponse({
            "logged_in": True,
            "user": user
        })
    else:
        return JSONResponse({
            "logged_in": False
        }, status_code=401)


@app.get("/api/logout")
async def api_logout(request: Request):
    """API 登出端點（與統一 SSO 的 /logout 相同）"""
    return await sso.logout(request)


